        }

        .profile-button, .report-button {
            min-width: 180px;
            padding: 0.65rem 1.5rem;
        }
    }
</style>

@code {
    string buttonText = "";
    Tuners tuners = new Tuners();
    Tuners other = new Tuners();
    ChatsDB chatsDB = new ChatsDB();
    RequestsDB requestsDB = new RequestsDB();
    ReportsDB reportsDB = new ReportsDB();

    bool showReport = false;
    bool reportSubmitted = false;
    string selectedCategory = "";
    string otherText = "";
    string cooldownMessage = "";

    List<string> reportCategories = new ReportsDB().GetReportCategories();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await MySession.GetAsync<Tuners>("Tuner");
            if (!result.Success || result.Value == null)
            {
                navigationManager.NavigateTo("/");
                return;
            }

            tuners = result.Value;

            var result2 = await MySession.GetAsync<Tuners>("Other");
            if (!result2.Success || result2.Value == null)
            {
                navigationManager.NavigateTo("/");
                return;
            }

            other = result2.Value;

            await DetermineStatus();
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
            navigationManager.NavigateTo("/");
        }
    }

    private async Task DetermineStatus()
    {
        var chat = await chatsDB.SelectChatByUserId(other.Id, tuners.Id);

        if (chat != null)
        {
            buttonText = "Go To Chat !";
            return;
        }

        var request = await requestsDB.GetRequestBetween2Users(tuners.Id, other.Id);

        if (request != null)
        {
            buttonText = "Already Requested! Waiting For Answer...";
            return;
        }

        buttonText = "Send Request";
    }

    private async Task HandleClick()
    {
        if (buttonText == "Go To Chat !")
        {
            Chats chats = await chatsDB.SelectChatByUserId(tuners.Id, other.Id);
            MySession.SetAsync("Chats", chats);
            navigationManager.NavigateTo("/Chat");
        }
        else if (buttonText == "Already Requested! Waiting For Answer...")
        {
            await requestsDB.Unsend(tuners.Id, other.Id);
            buttonText = "Send Request";
            StateHasChanged();
        }
        else if (buttonText == "Request denied ): You Can Try To Send Again")
        {
            await requestsDB.Unsend(tuners.Id, other.Id);
            await requestsDB.NewRequest(tuners.Id, other.Id);
            buttonText = "Already Requested! Waiting For Answer...";
            StateHasChanged();
        }
        else if (buttonText == "Send Request")
        {
            await requestsDB.NewRequest(tuners.Id, other.Id);
            buttonText = "Already Requested! Waiting For Answer...";
            StateHasChanged();
        }
    }

    private void OpenReport()
    {
        showReport = true;
        reportSubmitted = false;
        selectedCategory = "";
        otherText = "";
        cooldownMessage = "";
    }

    private void CloseReport()
    {
        showReport = false;
        reportSubmitted = false;
        selectedCategory = "";
        otherText = "";
        cooldownMessage = "";
    }

    private async Task SubmitReport()
    {
        if (string.IsNullOrEmpty(selectedCategory))
            return;

        string reportText = selectedCategory == "Other" && !string.IsNullOrWhiteSpace(otherText)
            ? otherText
            : selectedCategory;

        Reports report = new Reports()
        {
            reporter = tuners.Id,
            reported = other.Id,
            report = reportText
        };

        TimeSpan? remaining = await reportsDB.InsertGetObjAsync(report);

        if (remaining.HasValue)
        {
            int hours = (int)remaining.Value.TotalHours;
            int minutes = remaining.Value.Minutes;
            cooldownMessage = $"You already reported this user. Try again in {hours}h {minutes}m.";
        }
        else
        {
            reportSubmitted = true;
        }

        StateHasChanged();
    }

   
    private void GoBack()
    {
        navigationManager.NavigateTo("/Chatsss");
    }

    private string GetInitials(string username)
    {
        if (string.IsNullOrWhiteSpace(username)) return "?";
        var parts = username.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}";
        return username.Length >= 2 ? username.Substring(0, 2) : username.Substring(0, 1);
    }
}