        color: #FF7A00;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        width: 40px;
        height: 40px;
    }

        .back-button:hover {
            background-color: rgba(255, 122, 0, 0.1);
            border-radius: 50%;
            transform: scale(1.1);
        }

    .hero-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #FF7A00;
        margin: 0;
    }
    

    .profile-page {
        min-height: calc(100vh - 80px);
        background-color: #3B1F1F;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .profile-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
    }

    .profile-avatar {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: linear-gradient(135deg, #FF7A00, #FF9A00);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: bold;
        color: white;
        text-transform: uppercase;
        box-shadow: 0 6px 18px rgba(255,122,0,0.35);
        border: 3px solid #2D1616;
    }

    .profile-button {
        background: linear-gradient(135deg, #FF7A00, #cc6200);
        border: none;
        border-radius: 10px;
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        padding: 0.75rem 2rem;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        min-width: 220px;
    }

