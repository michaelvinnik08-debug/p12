@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Moduls
@using DBL
@inject ProtectedSessionStorage MySession
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@page "/Profile"

<h1 class="hero-title" style="text-align:center">@other.username</h1>
<div class="profile-page">
    <div class="profile-container">

        <!-- Avatar -->
        <div class="profile-avatar">
            @GetInitials(other.username)
        </div>

        <!-- Action Button -->
        <button class="profile-button" @onclick="HandleClick">
            @buttonText
        </button>

    </div>
</div>

<style>
    .profile-page {
        min-height: 100vh;
        background-color: #3B1F1F;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .profile-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
    }

    /* Bigger circle */
    .profile-avatar {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: linear-gradient(135deg, #FF7A00, #FF9A00);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem; /* Bigger letters */
        font-weight: bold;
        color: white;
        text-transform: uppercase;
        box-shadow: 0 6px 18px rgba(255,122,0,0.35);
        border: 3px solid #2D1616; /* thinner visual feel */
    }

    /* Centered button */
    .profile-button {
        background: linear-gradient(135deg, #FF7A00, #cc6200);
        border: none;
        border-radius: 10px;
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        padding: 0.75rem 2rem;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        min-width: 220px;
    }

        .profile-button:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 18px rgba(255,122,0,0.45);
        }

        .profile-button:active {
            transform: scale(0.97);
        }

    @@media (max-width: 600px) {
        .profile-avatar {
            width: 110px;
            height: 110px;
            font-size: 2.2rem;
        }

        .profile-button {
            min-width: 180px;
            padding: 0.65rem 1.5rem;
        }
    }
</style>

@code {
    string buttonText = "";
    Tuners tuners = new Tuners();
    Tuners other = new Tuners();
    ChatsDB chatsDB = new ChatsDB();
    RequestsDB requestsDB = new RequestsDB();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await MySession.GetAsync<Tuners>("Tuner");
            if (!result.Success || result.Value == null)
            {
                navigationManager.NavigateTo("/");
                return;
            }

            tuners = result.Value;

            var result2 = await MySession.GetAsync<Tuners>("Other");
            if (!result2.Success || result2.Value == null)
            {
                navigationManager.NavigateTo("/");
                return;
            }

            other = result2.Value;

            await DetermineStatus();
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
            navigationManager.NavigateTo("/");
        }
    }

    private async Task DetermineStatus()
    {
        var chat = await chatsDB.SelectChatByUserId(other.Id, tuners.Id);

        if (chat != null)
        {
            buttonText = "Go To Chat !";
            return;
        }

        var request = await requestsDB.GetRequestBetween2Users(tuners.Id, other.Id);

        if (request != null)
        {
            if (request.denied == 1)
            {
                buttonText = "Request denied ): You Can Try To Send Again";
            }
            else
            {
                buttonText = "Already Requested! Waiting For Answer...";
            }

            return;
        }

        buttonText = "Send Request";
    }

    private async Task HandleClick()
    {
        if (buttonText == "Go To Chat !")
        {
            Chats chats = await chatsDB.SelectChatByUserId(tuners.Id, other.Id);
            MySession.SetAsync("Chats", chats);
            navigationManager.NavigateTo("/Chat");
        }
        else if (buttonText == "Already Requested! Waiting For Answer...")
        {
            await requestsDB.Unsend(tuners.Id, other.Id);
            buttonText = "Send Request";
            StateHasChanged();
        }
        else if (buttonText == "Request denied ): You Can Try To Send Again")
        {
            await requestsDB.Unsend(tuners.Id, other.Id);
            await requestsDB.NewRequest(tuners.Id, other.Id);
            buttonText = "Already Requested! Waiting For Answer...";
            StateHasChanged();
        }
        else if (buttonText == "Send Request")
        {
            await requestsDB.NewRequest(tuners.Id, other.Id);
            buttonText = "Already Requested! Waiting For Answer...";
            StateHasChanged();
        }
    }

    // Added from first page (UNCHANGED logic)
    private string GetInitials(string username)
    {
        if (string.IsNullOrWhiteSpace(username)) return "?";
        var parts = username.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}";
        return username.Length >= 2 ? username.Substring(0, 2) : username.Substring(0, 1);
    }
}