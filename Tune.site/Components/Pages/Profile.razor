@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Moduls
@using DBL
@inject ProtectedSessionStorage MySession
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@page "/Profile"


<div class="profile-header">
    <button class="back-button" @onclick="GoBack">←</button>
    <h1 class="hero-title">@other.username</h1>
    <div></div> @* Spacer for centering *@
</div>


<div class="profile-page">
    <div class="profile-container">
       
        <div class="profile-avatar">
            @GetInitials(other.username)
        </div>
        <button class="profile-button" @onclick="HandleClick">
            @buttonText
        </button>

       
        <button class="report-button" @onclick="OpenReport">
            Report
        </button>
    </div>
</div>


@if (showReport)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <p class="modal-title">Report user</p>
            <p class="modal-subtitle">Select the main reason for your report. It will remain anonymous.</p>

            @if (!string.IsNullOrEmpty(cooldownMessage))
            {
                <p class="cooldown-msg">⏳ @cooldownMessage</p>
            }
            else if (reportSubmitted)
            {
                <p class="success-msg">✅ Report submitted. Thank you.</p>
            }
            else
            {
                if (buttonText == "Go To Chat !")
                {
                <div class="options-list">
                    @foreach (var category in reportCategories)
                    {
                        <label class="option-label">
                            <input type="radio" name="report" value="@category"
                                   @onchange="() => selectedCategory = category" />
                            <span class="option-text">@category</span>
                        </label>
                    }
                </div>
                }
                else
                {
                    <div class="options-list">
                        @for (int i = 0; i < Math.Min(2, reportCategories.Count); i++)
                        {
                            <label class="option-label">
                                <input type="radio" name="report" value="@reportCategories[i]"
                                       @onchange="() => selectedCategory = reportCategories[i]" />
                                <span class="option-text">@reportCategories[i]</span>
                            </label>
                        }
                    </div>
                }
                }
                @if (selectedCategory == "Other")
                {
                    <textarea class="other-textarea" placeholder="Describe the issue..."
                              @bind="otherText"></textarea>
                }

                <div class="modal-buttons">
                    <button class="cancel-button" @onclick="CloseReport">Cancel</button>
                    <button class="submit-button" @onclick="SubmitReport">Submit report</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(cooldownMessage) || reportSubmitted)
            {
                <div class="modal-buttons" style="margin-top: 1rem;">
                    <button class="cancel-button" style="flex:1" @onclick="CloseReport">Close</button>
                </div>
            }
        </div>
    </div>
}

<style>
   
    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 1rem;
        background-color: #2D1616;
