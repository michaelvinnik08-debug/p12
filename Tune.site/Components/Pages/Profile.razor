    .report-button {
        background: transparent;
        border: 0.5px solid #555;
        border-radius: 10px;
        color: #aaa;
        font-size: 0.9rem;
        padding: 0.5rem 1.5rem;
        cursor: pointer;
        min-width: 220px;
        transition: border-color 0.2s ease, color 0.2s ease;
    }

        .report-button:hover {
            border-color: #e8450a;
            color: #e8450a;
