@page "/Register"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject NavigationManager navigationManager
@inject IJSRuntime JS
@using Moduls
@using DBL

<PageTitle>TUNETALK REGISTER</PageTitle>
<style>
    :root {
        --primary-color: #FF7A00;
        --primary-hover: #FF9E3D;
        --background1: #3B1F1F;
        --background2: #1E1A1A;
        --background3: #4A2C2C;
        --card-bg: #2E2424;
        --text-color: #FFF3E2;
        --muted-text: #C7B6A3;
        --accent-color: #E94E77;
        --border-radius: 12px;
        --input-bg: #3C2E2E;
        --input-border: #4F3C3C;
        --shadow: 0 8px 20px rgba(255, 122, 0, 0.4);
        --font-family: "Inter", system-ui, sans-serif;
    }

    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family: var(--font-family);
        overflow-x: hidden;
    }

    .page-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, var(--background1), var(--background2), var(--background3));
        background-size: 300% 300%;
        animation: bgFlow 20s ease-in-out infinite;
        z-index: 0;
    }

    @@keyframes bgFlow {
        0%   { background-position: 0% 0%; }
        50%  { background-position: 100% 100%; }
        100% { background-position: 0% 0%; }
    }

    .register-page {
        position: relative;
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2;
        padding: 2rem 1rem;
        box-sizing: border-box;
    }

    .card {
        position: relative;
        z-index: 2;
        background-color: var(--card-bg);
        padding: 2.5rem 3rem;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
        width: 340px;
        max-width: 90vw;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    h1.hero-title {
        margin-bottom: 1rem;
        font-weight: 900;
        font-size: 2.5rem;
        color: var(--primary-color);
        text-shadow: 0 0 12px var(--primary-color);
    }

    label {
        font-weight: bold;
        color: var(--muted-text);
        display: block;
        margin-bottom: 0.3rem;
        text-align: left;
    }

    input[type="text"],
    input[type="email"],
    input[type="password"],
    input[type="number"] {
        width: 100%;
        padding: 0.7rem 0.85rem;
        margin-bottom: 0.8rem;
        border-radius: var(--border-radius);
        border: 1px solid var(--input-border);
        background-color: var(--input-bg);
        color: var(--text-color);
        font-size: 1.05rem;
        outline: none;
        box-shadow: inset 0 0 5px rgba(0,0,0,0.7);
        transition: 0.3s;
        box-sizing: border-box;
    }

    input:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 12px var(--primary-color);
        background-color: #412e1a;
    }

    button {
        width: 100%;
        padding: 0.7rem;
        border: none;
        border-radius: 6px;
        margin-bottom: 0.6rem;
        cursor: pointer;
        font-size: 1rem;
        font-weight: bold;
        box-shadow: 0 0 10px transparent;
        transition: background 0.3s, box-shadow 0.3s;
    }

    .primary-btn {
        background: var(--primary-color);
        color: white;
        box-shadow: 0 0 10px var(--primary-color);
    }

        .primary-btn:hover {
            background: #ff8f2d;
            box-shadow: 0 0 20px #ff8f2d;
        }

    .secondary-btn {
        background: white;
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        box-shadow: 0 0 10px var(--primary-color);
    }

        .secondary-btn:hover {
            background: var(--primary-color);
            color: white;
            box-shadow: 0 0 20px var(--primary-color);
        }

    .error-msg {
        color: var(--accent-color);
        font-weight: 600;
        min-height: 1.2rem;
        font-size: 0.9rem;
        text-align: center;
    }

    .card p {
        color: var(--muted-text);
        font-size: 0.95rem;
        margin: 0 0 0.5rem 0;
    }

        .card p strong {
            color: var(--primary-color);
        }

    /* Picture upload area */
    .picture-upload {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-bottom: 0.8rem;
    }

    .avatar-preview {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--primary-color);
        box-shadow: 0 0 10px var(--primary-color);
    }

    .avatar-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: var(--input-bg);
        border: 2px dashed var(--input-border);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted-text);
        font-size: 2rem;
    }

    .upload-label {
        cursor: pointer;
        color: var(--primary-color);
        font-size: 0.9rem;
        font-weight: bold;
        text-decoration: underline;
        text-align: center;
    }

        .upload-label:hover {
            color: var(--primary-hover);
        }

    /* Music notes */
    .music-note {
        position: fixed;
        pointer-events: none;
        user-select: none;
        color: rgba(255, 122, 0, 0.75);
        font-size: var(--note-size);
        animation-name: floatMove, pulseGlow;
        animation-timing-function: linear, ease-in-out;
        animation-fill-mode: forwards;
        animation-iteration-count: 1, infinite;
        will-change: transform, opacity, filter;
        z-index: 1;
    }

    @@keyframes floatMove {
        0%   { transform: translate(0, 0) rotate(0deg); opacity: 1; }
        70%  { opacity: 1; }
        100% { transform: translate(var(--move-x), var(--move-y)) rotate(360deg); opacity: 0; }
    }

    @@keyframes pulseGlow {
        0%   { filter: drop-shadow(0 0 2px rgba(255, 140, 0, 0.4)); }
        50%  { filter: drop-shadow(0 0 12px rgba(255, 140, 0, 0.85)); }
        100% { filter: drop-shadow(0 0 2px rgba(255, 140, 0, 0.4)); }
    }
</style>

<script>
    if (!window.__musicNotesInitialized) {
        window.__musicNotesInitialized = true;
        window.__activeNotes = new Set();
        window.__spawnTimerIds = [];
    }

    window.startMusicNotesAnimation = () => {
        document.querySelectorAll(".music-note").forEach(n => n.remove());
        window.__activeNotes.clear();

        const TOTAL_NOTES = 150;
        const noteSymbols = ["\u266A", "\u266B", "\u2669", "\u266C"];
        const animationDurationRange = [4000, 8000];
        const noteSizeRange = [14, 30];

        function randomRange(min, max) { return Math.random() * (max - min) + min; }
        function randomMovement(min, max, minAbs) {
            let v;
            do { v = randomRange(min, max); } while (Math.abs(v) < minAbs);
            return v;
        }

        function spawnNote() {
            if (window.__activeNotes.size >= TOTAL_NOTES) return;
            const note = document.createElement("div");
            note.classList.add("music-note");
            window.__activeNotes.add(note);
            note.textContent = noteSymbols[Math.floor(Math.random() * noteSymbols.length)];
            const size = randomRange(noteSizeRange[0], noteSizeRange[1]);
            note.style.setProperty("--note-size", size + "px");
            note.style.left = randomRange(0, window.innerWidth) + "px";
            note.style.top = randomRange(0, window.innerHeight) + "px";
            const moveX = randomMovement(-150, 150, 40);
            const moveY = randomMovement(-150, 150, 40);
            note.style.setProperty("--move-x", moveX + "px");
            note.style.setProperty("--move-y", moveY + "px");
            const duration = randomRange(animationDurationRange[0], animationDurationRange[1]);
            const glowDelay = randomRange(0, 1500);
            note.style.animationDuration = `${duration}ms, 2000ms`;
            note.style.animationDelay = `0ms, ${glowDelay}ms`;
            document.body.appendChild(note);
            const timeoutId = setTimeout(() => {
                window.__activeNotes.delete(note);
                note.remove();
                spawnNote();
            }, duration + 50);
            window.__spawnTimerIds.push(timeoutId);
        }

        for (let i = 0; i < TOTAL_NOTES; i++) spawnNote();
    };

    window.stopMusicNotesAnimation = () => {
        window.__activeNotes.forEach(n => n.remove());
        window.__activeNotes.clear();
        for (let id of window.__spawnTimerIds) clearTimeout(id);
        window.__spawnTimerIds = [];
    };

    window.addEventListener("beforeunload", () => window.stopMusicNotesAnimation());

    // Read a file input as base64 data URL
    window.readFileAsBase64 = (inputId) => {
        return new Promise((resolve, reject) => {
            const input = document.getElementById(inputId);
            if (!input || !input.files || input.files.length === 0) {
                resolve(null);
                return;
            }
            const file = input.files[0];
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result);
            reader.onerror = () => reject(reader.error);
            reader.readAsDataURL(file);
        });
    };
</script>

<div class="page-background"></div>
<div class="register-page">
    <div class="card">
        <h1 class="hero-title">Register</h1>

        @if (step == 1)
        {
            <label>Email</label>
            <input type="email" @bind-value="email" placeholder="Enter your email" autocomplete="email" />
            <button class="primary-btn" @onclick="SendEmail">Send Code</button>
            <button class="secondary-btn" @onclick="GoToLogin">Back To Login</button>
        }

        @if (step == 2)
        {
            <p>We sent a code to <strong>@email</strong></p>
            <label>Enter Code</label>
            <input type="number" @bind-value="userCode" placeholder="Enter 6-digit code" />
            <button class="primary-btn" @onclick="CheckCode">Verify</button>
            <button class="secondary-btn" @onclick="SendEmail">Resend Code</button>
        }

        @if (step == 3)
        {
            <label>Username</label>
            <input type="text" @bind-value="username" placeholder="Choose a username" autocomplete="username" />

            <label>Password</label>
            <input type="password" @bind-value="password" placeholder="Create a password" autocomplete="new-password" />

            <label>Confirm Password</label>
            <input type="password" @bind-value="passwordconf" placeholder="Confirm your password" autocomplete="new-password" />

            <label>Profile Picture (optional)</label>
            <div class="picture-upload">
                @if (!string.IsNullOrEmpty(picturePreview))
                {
                    <img class="avatar-preview" src="@picturePreview" alt="Preview" />
                }
                else
                {
                    <div class="avatar-placeholder">&#9835;</div>
                }
                <label class="upload-label" for="picInput">
                    @(string.IsNullOrEmpty(picturePreview) ? "Choose a picture" : "Change picture")
                </label>
                <InputFile id="picInput" OnChange="OnPictureSelected" accept="image/*" style="display:none" />
            </div>

            <button class="primary-btn" @onclick="CreateAccount">Create Account</button>
        }

        <p class="error-msg">@errorMsg</p>
    </div>
</div>

@code {
    int step = 1;
    int confnum = 0;
    string email = "";
    int userCode = 0;
    string username = "";
    string password = "";
    string passwordconf = "";
    string errorMsg = "";
    string picturePreview = "";   // base64 data URL shown in <img>
    string pictureBase64 = "";    // base64 string saved to DB (may be null)

    TunersDB TunersDB = new TunersDB();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("startMusicNotesAnimation");
    }

    public async Task SendEmail()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMsg = "Please enter your email.";
            return;
        }

        List<string> existingEmails = await TunersDB.GetAllEmailsAsync();
        if (existingEmails.Contains(email))
        {
            errorMsg = "This email is already in use.";
            return;
        }

        try
        {
            Random rnd = new Random();
            confnum = rnd.Next(100000, 999999);
            await EmailService.SendMessage(email, confnum);
            step = 2;
            errorMsg = "";
        }
        catch (Exception ex)
        {
            errorMsg = "Failed to send email: " + ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }
    public async Task CheckCode()
    {
        if (userCode == confnum)
        {
            step = 3;
            errorMsg = "";
            StateHasChanged();
        }
        else
        {
            errorMsg = "Wrong code, try again!";
            StateHasChanged();
        }
    }

    // ── Step 3: handle picture file selection ──
    private async Task OnPictureSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Limit to 4 MB
        if (file.Size > 5 * 1024 * 1024)
        {
            errorMsg = "Image must be smaller than 4 MB.";
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var ms = new System.IO.MemoryStream();
        await stream.CopyToAsync(ms);
        byte[] bytes = ms.ToArray();
        string base64 = Convert.ToBase64String(bytes);
        string mimeType = file.ContentType;

        pictureBase64 = $"data:{mimeType};base64,{base64}";
        picturePreview = pictureBase64;
        errorMsg = "";
        StateHasChanged();
    }

    private bool ValidatePassword(string pwd)
    {
        if (pwd.Length < 6)
        {
            errorMsg = "Password must be at least 6 characters long.";
            return false;
        }
        if (!pwd.Any(char.IsDigit))
        {
            errorMsg = "Password must contain at least 1 number.";
            return false;
        }
        if (!pwd.Any(ch => !char.IsLetterOrDigit(ch)))
        {
            errorMsg = "Password must contain at least 1 special character.";
            return false;
        }
        return true;
    }

    public async Task CreateAccount()
    {
        if (string.IsNullOrWhiteSpace(username))
        {
            errorMsg = "Username is required.";
            return;
        }

        if (password != passwordconf)
        {
            passwordconf = "";
            errorMsg = "Confirm Password must match Password.";
            return;
        }

        if (!ValidatePassword(password))
        {
            password = "";
            passwordconf = "";
            return;
        }

        // Register the user (no picture yet)
        Tuners tuner = await TunersDB.Reg(username, email, password);
        if (tuner == null)
        {
            errorMsg = "Email already in use — please go back and try another.";
            return;
        }

        if (!string.IsNullOrEmpty(pictureBase64))
        {
            await TunersDB.UpdatePictureAsync(tuner.Id, pictureBase64);
            tuner.picture = null; // don't store large blob in session
        }

        await MySession.SetAsync("Tuner", tuner);
        navigationManager.NavigateTo("/Chatsss");
    }

    void GoToLogin()
    {
        navigationManager.NavigateTo("/");
    }
}
