@page "/Register"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject NavigationManager navigationManager
@inject IJSRuntime JS
@using Moduls
@using DBL

<PageTitle>TUNETALK REGISTER</PageTitle>
<style>
    :root {
        --primary-color: #FF7A00;
        --primary-hover: #FF9E3D;
        --background1: #3B1F1F;
        --background2: #1E1A1A;
        --background3: #4A2C2C;
        --card-bg: #2E2424;
        --text-color: #FFF3E2;
        --muted-text: #C7B6A3;
        --accent-color: #E94E77;
        --border-radius: 12px;
        --input-bg: #3C2E2E;
        --input-border: #4F3C3C;
        --shadow: 0 8px 20px rgba(255, 122, 0, 0.4);
        --font-family: "Inter", system-ui, sans-serif;
    }

    /* Body & page */
    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family: var(--font-family);
        overflow-x: hidden;
    }

    /* Gradient background animation */
    .page-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, var(--background1), var(--background2), var(--background3));
        background-size: 300% 300%;
        animation: bgFlow 20s ease-in-out infinite;
        z-index: 0;
    }

    .register-page {
        position: relative;
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2;
        padding: 2rem 1rem;
        box-sizing: border-box;
    }

    /* Card */
    .card {
        position: relative;
        z-index: 2;
        background-color: var(--card-bg);
        padding: 2.5rem 3rem;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
        width: 340px;
        max-width: 90vw;
        text-align: center;
    }

    /* Titles */
    h1.hero-title {
        margin-bottom: 1.5rem;
        font-weight: 900;
        font-size: 2.5rem;
        color: var(--primary-color);
        text-shadow: 0 0 12px var(--primary-color);
    }

    h3 {
        font-weight: 500;
        margin-bottom: 0.3rem;
        text-align: left;
        color: var(--muted-text);
    }

    /* Inputs */
    input[type="text"], input[type="email"], input[type="password"] {
        width: 100%;
        padding: 0.7rem 0.85rem;
        margin-bottom: 1.3rem;
        border-radius: var(--border-radius);
        border: 1px solid var(--input-border);
        background-color: var(--input-bg);
        color: var(--text-color);
        font-size: 1.05rem;
        outline: none;
        box-shadow: inset 0 0 5px rgba(0,0,0,0.7);
        transition: 0.3s;
    }

    input:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 12px var(--primary-color);
        background-color: #412e1a;
    }

    /* Buttons */
    button {
        width: 100%;
        padding: 0.7rem;
        border: none;
        border-radius: 6px;
        margin-bottom: 1rem;
        cursor: pointer;
        font-size: 1rem;
        font-weight: bold;
        box-shadow: 0 0 10px transparent;
        transition: background 0.3s, box-shadow 0.3s;
    }

    .register-btn {
        background: var(--primary-color);
        color: white;
        box-shadow: 0 0 10px var(--primary-color);
    }

        .register-btn:hover {
            background: #ff8f2d;
            box-shadow: 0 0 20px #ff8f2d;
        }

    .login-btn {
        background: white;
        width:100%;
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        box-shadow: 0 0 10px var(--primary-color);
    }

        .login-btn:hover {
            background: var(--primary-color);
            color: white;
            box-shadow: 0 0 20px var(--primary-color);
        }

    /* Message */
    .message {
        margin-bottom: 1rem;
        color: var(--accent-color);
        font-weight: 600;
        min-height: 1.2rem;
    }

    /* Floating Notes */
    .music-note {
        position: fixed;
        pointer-events: none;
        user-select: none;
        color: rgba(255, 122, 0, 0.75);
        font-size: var(--note-size);
        animation-name: floatMove, pulseGlow;
        animation-timing-function: linear, ease-in-out;
        animation-fill-mode: forwards;
        animation-iteration-count: 1, infinite;
        will-change: transform, opacity, filter;
        z-index: 1;
    }

    @@keyframes floatMove {
        0% {
            transform: translate(0, 0) rotate(0deg);
            opacity: 1;
        }

        70% {
            opacity: 1;
        }

        100% {
            transform: translate(var(--move-x), var(--move-y)) rotate(360deg);
            opacity: 0;
        }
    }

    @@keyframes pulseGlow {
        0% {
            filter: drop-shadow(0 0 2px rgba(255, 140, 0, 0.4));
        }

        50% {
            filter: drop-shadow(0 0 12px rgba(255, 140, 0, 0.85));
        }

        100% {
            filter: drop-shadow(0 0 2px rgba(255, 140, 0, 0.4));
        }
    }
</style>

<script>

    // --- GLOBAL STATE (prevents duplication on page reloads) ---
    if (!window.__musicNotesInitialized) {
        window.__musicNotesInitialized = true;
        window.__activeNotes = new Set();       // all active notes
        window.__spawnTimerIds = [];            // timers for respawning notes
    }

    window.startMusicNotesAnimation = () => {

        // Clear existing notes (visual cleanup only — timers cleared in stop fn)
        document.querySelectorAll(".music-note").forEach(n => n.remove());
        window.__activeNotes.clear();

        const TOTAL_NOTES = 150;
        const noteSymbols = ["\u266A", "\u266B", "\u2669", "\u266C"];
        const animationDurationRange = [4000, 8000];
        const noteSizeRange = [14, 30];

        function randomRange(min, max) {
            return Math.random() * (max - min) + min;
        }

        function randomMovement(min, max, minAbs) {
            let v;
            do { v = randomRange(min, max); }
            while (Math.abs(v) < minAbs);
            return v;
        }

        // --- SPAWN A SINGLE NOTE ---
        function spawnNote() {
            if (window.__activeNotes.size >= TOTAL_NOTES) return;

            const note = document.createElement("div");
            note.classList.add("music-note");
            window.__activeNotes.add(note);

            note.textContent = noteSymbols[Math.floor(Math.random() * noteSymbols.length)];

            const size = randomRange(noteSizeRange[0], noteSizeRange[1]);
            note.style.setProperty("--note-size", size + "px");

            note.style.left = randomRange(0, window.innerWidth) + "px";
            note.style.top = randomRange(0, window.innerHeight) + "px";

            const moveX = randomMovement(-150, 150, 40);
            const moveY = randomMovement(-150, 150, 40);

            note.style.setProperty("--move-x", moveX + "px");
            note.style.setProperty("--move-y", moveY + "px");

            const duration = randomRange(animationDurationRange[0], animationDurationRange[1]);
            const glowDelay = randomRange(0, 1500);

            note.style.animationDuration = `${duration}ms, 2000ms`;
            note.style.animationDelay = `0ms, ${glowDelay}ms`;

            document.body.appendChild(note);

            const timeoutId = setTimeout(() => {
                window.__activeNotes.delete(note);
                note.remove();
                spawnNote();
            }, duration + 50);

            window.__spawnTimerIds.push(timeoutId);
        }

        // Create initial set of notes
        for (let i = 0; i < TOTAL_NOTES; i++) {
            spawnNote();
        }
    };

    // --- STOP & CLEAN EVERYTHING COMPLETELY ---
    window.stopMusicNotesAnimation = () => {

        // Remove note elements
        window.__activeNotes.forEach(n => n.remove());
        window.__activeNotes.clear();

        // Clear all timers
        for (let id of window.__spawnTimerIds) {
            clearTimeout(id);
        }

        window.__spawnTimerIds = [];
    };

    // Stop automatically when leaving page
    window.addEventListener("beforeunload", () => {
        window.stopMusicNotesAnimation();
    });

</script>



<div class="page-background"></div>
<div class="register-page">
    <div class="card">
        <h1 class="hero-title">Register</h1>

        <h3>Enter Username</h3>
        <input type="text" @bind-value="username" placeholder="Username" autocomplete="username" />

        <h3>Enter Email</h3>
        <input type="email" @bind-value="email" placeholder="Email" autocomplete="email" />

        <h3>Enter Password</h3>
        <input type="password" @bind-value="password" placeholder="Password" autocomplete="new-password" />

        <button class="register-btn" @onclick="Registar" >Register</button>
        <button class="login-btn" @onclick="Login">Back To Login</button>
        <div class="message">@message</div>
    </div>
</div>

@code {
    string username = "";
    string email = "";
    string password = "";
    string message = "";

    public async Task Registar()
    {
        TunersDB f = new TunersDB();

        if (email!=null)
        {
            Tuners tuners =await f.Reg(username, email, password);
            if(tuners==null)
            {
                message = "email already in use,try another one";
                email = "";
            }
            else{
                message = "Registered!";
                Thread.Sleep(2000);
                await MySession.SetAsync("Tuner", tuners);
                navigationManager.NavigateTo("/Chats");
            }
        }

        else
            message = "The email is required!";
    }
    void Login()
    {
        navigationManager.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("startMusicNotesAnimation");
    }
}
