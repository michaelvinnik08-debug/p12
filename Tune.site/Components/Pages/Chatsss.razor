        .search-tab-btn svg {
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .search-tab-btn.search-open svg {
            transform: scaleX(-1);
        }

    .search-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: 50%;
        height: 100vh;
        background-color: #2D1616;
        border-left: 2px solid #FF7A00;
        z-index: 1099;
        transform: translateX(100%);
