    }

        .search-panel.search-panel-open {
            transform: translateX(0);
        }

    .search-panel-inner {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 1.5rem 1.25rem 1rem;
        gap: 1rem;
        overflow: hidden;
    }

    .search-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }

    .search-panel-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #FF7A00;
    }

    .search-close-btn {
        background: none;
        border: none;
        color: #B8A89A;
        font-size: 1.1rem;
        cursor: pointer;
        padding: 0.3rem 0.5rem;
