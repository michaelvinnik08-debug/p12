    }

        .search-close-btn:hover {
            color: #FF7A00;
            background-color: rgba(255,122,0,0.1);
        }

    .search-bar-row {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        flex-shrink: 0;
    }

    .search-input {
        width: 100%;
        background-color: #3C2E2E;
        border: 1.5px solid #4F3C3C;
        border-radius: 8px;
        color: #FFF3E2;
        font-size: 0.95rem;
