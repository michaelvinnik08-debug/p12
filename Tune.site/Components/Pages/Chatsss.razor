        }

    .search-tab-btn {
        position: fixed;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1100;
        background: linear-gradient(180deg, #FF7A00 0%, #1a0a00 100%);
        border: 2px solid #FF7A00;
        border-right: none;
