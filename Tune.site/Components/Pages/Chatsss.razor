@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@using Moduls
@using DBL
@inject IJSRuntime JS
@page "/Chatsss"

<div class="chats-page">
    <!-- Header -->
    <div class="chats-header">
        <h1 class="chats-title">Chats</h1>
        <h1 class="chats-title">HI @name </h1>
        <div class="header-actions">
            <button class="menu-button" @onclick="ToggleMenu">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </button>
        </div>
    </div>

    <!-- Context Menu -->
    @if (showMenu)
    {
        <div class="context-menu" style="top: 60px; right: 10px;">
            <button @onclick="Update">⚙️ Update Profile</button>
            <button @onclick="Requests">📥 Requests Page</button>
            <button @onclick="Tuning">🎶 Tuning Page</button>
            @if (tuners.role == 1)
            {
                <button @onclick="GoToAdmin">👑 Admin Page</button>
            }
        </div>
    }

    <!-- Overlay to close menu -->
    @if (showMenu)
    {
        <div class="context-menu-overlay" @onclick="HideMenu"></div>
    }

    <!-- Chat List -->
    <div class="chats-container">
        @if (chats != null && chats.Count > 0)
        {
            @foreach (Chats c in chats)
            {
                <div class="chat-card" @onclick="() => Chat(c.id)">
                    @if (!string.IsNullOrEmpty(GetOtherUserPicture(c)))
                    {
                        <div class="chat-avatar" style="background:none; padding:0;">
                            <img src="@GetOtherUserPicture(c)"
                                 style="width:50px;height:50px;border-radius:50%;object-fit:cover;display:block;" />
                        </div>
                    }
                    else
                    {
                        <div class="chat-avatar">
                            @GetInitials(GetOtherUserName(c))
                        </div>
                    }
                    <div class="chat-content">
                        <div class="chat-header-row">
                            <span class="chat-username">@GetOtherUserName(c)</span>
                            <span class="chat-time">@GetTimeAgo(c.last)</span>
                        </div>
                        <div class="chat-message">@(string.IsNullOrEmpty(c.message) ? "No messages yet" : c.message)</div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">💬</div>
                <p>No chats yet</p>
                <p class="empty-subtitle">Start a conversation!</p>
            </div>
        }
    </div>

    <!-- Dim overlay -->
    <div class="search-panel-overlay @(showSearch ? "search-panel-visible" : "")" @onclick="HideSearch"></div>

    <!-- Tab button fixed to right edge, vertically centered -->
    <button class="search-tab-btn @(showSearch ? "search-open" : "")" @onclick="ToggleSearch" title="Find Users">
        <svg viewBox="0 0 12 24" xmlns="http://www.w3.org/2000/svg" width="12" height="24">
            <polyline points="9,3 3,12 9,21"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linejoin="round"
                      stroke-linecap="round" />
        </svg>
    </button>

    <!-- Sliding panel from right, covers 50% of screen width -->
    <div class="search-panel @(showSearch ? "search-panel-open" : "")">
        <div class="search-panel-inner">
            <div class="search-panel-header">
                <span class="search-panel-title">🔍 Find Users</span>
            </div>

            <div class="search-bar-row">
                <input class="search-input"
                       type="text"
                       placeholder="Type an email..."
                       @bind-value="searchQuery"
                       @bind:event="oninput"
                       @onkeydown="OnSearchKeyDown" />
                <button class="search-btn" @onclick="() => SearchUsers(searchQuery)">Search</button>
            </div>

            <div class="search-results">
                @if (isSearching)
                {
                    <div class="search-status">Searching...</div>
                }
                else if (searchResults != null && searchResults.Count == 0 && hasSearched)
                {
                    <div class="search-status">No users found.</div>
                }
                else if (searchResults != null)
                {
                    @foreach (var user in searchResults)
                    {
                        <div class="search-result-card">
                            @if (!string.IsNullOrEmpty(user.picture) && user.picture != "0")
                            {
                                <div class="search-avatar" style="background:none; padding:0;">
                                    <img src="@user.picture"
                                         style="width:38px;height:38px;border-radius:50%;object-fit:cover;display:block;" />
                                </div>
                            }
                            else
                            {
                                <div class="search-avatar">
                                    @GetInitials(user.username)
                                </div>
                            }
                            <div class="search-user-info">
                                <span class="search-username">@user.username</span>
                            </div>
                            <button class="send-request-btn" @onclick="() => ToProfile(user)">
                                👤 To Profile
                            </button>
                        </div>
                    }
                }
            </div>

            @if (!string.IsNullOrEmpty(requestFeedback))
            {
                <div class="request-feedback @(requestSuccess ? "feedback-success" : "feedback-error")">
                    @requestFeedback
                </div>
            }
        </div>
    </div>

</div>

<style>
