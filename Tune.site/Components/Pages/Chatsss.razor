</style>

@code {
    private bool showMenu = false;

    string name = "";
    string name2 = "";
    string message = "";
    List<Chats> chats = new List<Chats>();
    Dictionary<int, string> usernames = new Dictionary<int, string>();
    Dictionary<int, string> userpictures = new Dictionary<int, string>(); // stores pictures by user id
    Tuners T = new Tuners();
    ChatsDB C = new ChatsDB();
    TunersDB U = new TunersDB();
    Tuners tuners = new Tuners();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("stopMusicNotesAnimation");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await MySession.GetAsync<Tuners>("Tuner");
            if (result.Success)
            {
                tuners = result.Value;
                name = tuners.username;

                var Chatss = await C.SelectChats(tuners);
                if (Chatss is List<Chats>)
                {
                    chats = (List<Chats>)Chatss;
                    chats = chats.OrderByDescending(c => c.last).ToList();

                    foreach (var chat in chats)
                    {
                        int otherUserId = (chat.user1 == tuners.Id) ? chat.user2 : chat.user1;
                        if (!usernames.ContainsKey(otherUserId))
                        {
                            var otherUser = await U.SelectUserID(otherUserId);
                            if (otherUser != null)
                            {
                                usernames[otherUserId] = otherUser.username;
                                userpictures[otherUserId] = otherUser.picture; // fetch picture from DB
                            }
                        }
                    }
                }
            }
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
            navigationManager.NavigateTo("/");
        }
    }

    private string GetOtherUserName(Chats chat)
    {
        int otherUserId = GetOtherUserId(chat);
        return usernames.ContainsKey(otherUserId) ? usernames[otherUserId] : "Unknown";
    }

    // returns picture string or null if user has no picture
    private string GetOtherUserPicture(Chats chat)
    {
        int otherUserId = GetOtherUserId(chat);
        if (!userpictures.ContainsKey(otherUserId)) return null;
        string pic = userpictures[otherUserId];
        // treat null, empty, or "0" as no picture
        if (string.IsNullOrEmpty(pic) || pic == "0") return null;
        return pic;
    }

    private int GetOtherUserId(Chats chat)
    {
        return (chat.user1 == tuners.Id) ? chat.user2 : chat.user1;
    }
    // returns picture string or null if user has no picture
  
    private string GetInitials(string username)
    {
        if (string.IsNullOrWhiteSpace(username)) return "?";
        var parts = username.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}";
        return username.Length >= 2 ? username.Substring(0, 2) : username.Substring(0, 1);
    }

    private string GetTimeAgo(DateTime messageTime)
    {
        if (messageTime == DateTime.MinValue) return "";
        TimeSpan ago = DateTime.Now - messageTime;
        if (ago.TotalMinutes < 1) return "Now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h";
        return messageTime.ToString("MMM d");
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;
        StateHasChanged();
    }

    private void HideMenu()
    {
        showMenu = false;
        StateHasChanged();
    }

    async Task Chat(int id)
    {
        HideMenu();
        Chats chats = await C.SelectChatById(id);
        MySession.SetAsync("Chats", chats);
        navigationManager.NavigateTo("/Chat");
    }

    async Task Update()
    {
        HideMenu();
        navigationManager.NavigateTo("/Update");
    }

    async Task Tuning()
    {
        HideMenu();
        navigationManager.NavigateTo("/Tuning");
    }

    async Task Requests()
    {
        HideMenu();
        navigationManager.NavigateTo("/Requests");
    }

    async Task GoToAdmin()
    {
        HideMenu();
        navigationManager.NavigateTo("/Admin");
    }

    private bool showSearch = false;
    private string searchQuery = "";
    private List<Tuners> searchResults = null;
    private bool isSearching = false;
    private bool hasSearched = false;
    private string requestFeedback = "";
    private bool requestSuccess = false;

    private void ToggleSearch()
    {
        showSearch = !showSearch;
        if (showSearch)
        {
            showMenu = false;
            requestFeedback = "";
            searchResults = null;
            hasSearched = false;
        }
        StateHasChanged();
    }

    private void HideSearch()
    {
        showSearch = false;
        StateHasChanged();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchUsers(searchQuery);
    }

    private async Task SearchUsers(string email)
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        isSearching = true;
        hasSearched = true;
        requestFeedback = "";
        StateHasChanged();
        searchResults = await U.SelectUsersByEmail(email.Trim());
        isSearching = false;
        StateHasChanged();
    }

    private async Task ToProfile(Tuners targetUser)
    {
        // clear picture before storing in session to avoid size limit issues
        targetUser.picture = null;
        await MySession.SetAsync("Other", targetUser);
        navigationManager.NavigateTo("/Profile");
    }
}