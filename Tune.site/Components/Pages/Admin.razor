@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Moduls
@using DBL
@inject ProtectedSessionStorage MySession
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@page "/Admin"

<div class="admin-page">
    <!-- Header -->
    <div class="admin-header">
        <div class="header-left">
            <button class="back-button" @onclick="GoBack">←</button>
            <h1 class="admin-title">Admin Panel</h1>
        </div>
        <div class="report-count">
            @Report.Count unsolved reports
        </div>
    </div>

    <!-- Reports Container -->
    <div class="reports-container">
        @if (Report != null && Report.Count > 0)
        {
            @foreach (Reports R in Report)
            {
                <div class="report-card">
                    <div class="report-header">
                        <div class="report-info">
                            <span class="label">Reported User ID:</span>
                            <span class="value reported-id">@R.reported</span>
                        </div>
                        <div class="report-info">
                            <span class="label">Reporter ID:</span>
                            <span class="value">@R.reporter</span>
                        </div>
                    </div>

                    <div class="report-content">
                        <span class="label">Report Details:</span>
                        <p class="report-text">@R.report</p>
                    </div>

                    <div class="report-actions">
                        <button class="btn-ban" @onclick="() => BanUser(R.id, R.reported)">
                            🚫 Ban User
                        </button>
                        <button class="btn-dismiss" @onclick="() => DismissReport(R.id)">
                            ✓ Dismiss
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">✅</div>
                <p>No pending reports</p>
                <p class="empty-subtitle">All reports have been resolved</p>
            </div>
        }
    </div>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .admin-page {
        min-height: 100vh;
        background-color: #3B1F1F;
        color: #FFF3E2;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Header */
    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 1rem;
        background-color: #2D1616;
        border-bottom: 2px solid #FF7A00;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .back-button {
        background: none;
        border: none;
        color: #FF7A00;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        width: 40px;
        height: 40px;
    }

        .back-button:hover {
            background-color: rgba(255, 122, 0, 0.1);
            border-radius: 50%;
            transform: scale(1.1);
        }

    .admin-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #FF7A00;
        margin: 0;
    }

    .report-count {
        background-color: #FF7A00;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    /* Reports Container */
    .reports-container {
        padding: 1.5rem;
        max-width: 900px;
        margin: 0 auto;
    }

    /* Report Card */
    .report-card {
        background-color: #3C2E2E;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        border: 2px solid #4F3C3C;
        transition: all 0.3s ease;
        animation: cardSlideIn 0.4s ease-out;
    }

    @@keyframes cardSlideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .report-card:hover {
        border-color: #FF7A00;
        box-shadow: 0 4px 12px rgba(255, 122, 0, 0.2);
        transform: translateY(-2px);
    }

    /* Report Header */
    .report-header {
        display: flex;
        gap: 2rem;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #4F3C3C;
    }

    .report-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .label {
        font-size: 0.85rem;
        color: #B8A89A;
        font-weight: 500;
    }

    .value {
        font-size: 1.1rem;
        color: #FFF3E2;
        font-weight: 600;
    }

    .reported-id {
        color: #FF7A00;
    }

    /* Report Content */
    .report-content {
        margin-bottom: 1.5rem;
    }

    .report-text {
        margin-top: 0.5rem;
        padding: 1rem;
        background-color: #2D1616;
        border-radius: 8px;
        color: #FFF3E2;
        line-height: 1.5;
        border-left: 3px solid #FF7A00;
    }

    /* Report Actions */
    .report-actions {
        display: flex;
        gap: 0.75rem;
    }

        .report-actions button {
            flex: 1;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

    .btn-ban {
        background-color: #dc3545;
        color: white;
    }

        .btn-ban:hover {
            background-color: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
        }

        .btn-ban:active {
            transform: translateY(0);
        }

    .btn-dismiss {
        background-color: #4F3C3C;
        color: #FFF3E2;
    }

        .btn-dismiss:hover {
            background-color: #5D4848;
            transform: translateY(-2px);
        }

        .btn-dismiss:active {
            transform: translateY(0);
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #B8A89A;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .empty-state p {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
    }

    .empty-subtitle {
        font-size: 1rem;
        opacity: 0.7;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .admin-header {
            flex-direction: column;
            gap: 1rem;
            align-items: flex-start;
        }

        .header-left {
            width: 100%;
        }

        .report-count {
            align-self: flex-end;
        }

        .report-header {
            flex-direction: column;
            gap: 0.75rem;
        }

        .report-actions {
            flex-direction: column;
        }

            .report-actions button {
                width: 100%;
            }
    }
</style>

@code {
    ReportsDB ReportDB = new ReportsDB();
    List<Reports> Report = new List<Reports>();
    TunersDB Tune = new TunersDB();
    Tuners T = new Tuners();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await MySession.GetAsync<Tuners>("Tuner");
            if (result.Success)
            {
                T = result.Value;
                if (T.role == 1)
                {
                    Report = await ReportDB.GetAllAsync();
                }
                else { navigationManager.NavigateTo("/"); }
            }

        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
            navigationManager.NavigateTo("/");
        }
    }

    private async Task<bool> Ban(int id, int reported)
    {
        int t = await Tune.Bannedornot(0, reported);
        int r = await ReportDB.TheSolver(1, id);
        return r != 0 && t != 0;
    }
        

    
    private async Task BanUser(int reportId, int reportedUserId)
    {
        bool success = await Ban(reportId, reportedUserId);

        if (success)
        {
            // Remove this report from the list
            Report.RemoveAll(r => r.reported == reportedUserId);
            StateHasChanged();
        }
    }

    // NEW: Dismiss report without banning
    private async Task DismissReport(int reportId)
    {
        int result = await ReportDB.TheSolver(1, reportId);

        if (result != 0)
        {
            // Remove this specific report from the list
            Report.RemoveAll(r => r.id == reportId);
            StateHasChanged();
        }
    }

    
    private void GoBack()
    {
        navigationManager.NavigateTo("/Chatsss");
    }
}
